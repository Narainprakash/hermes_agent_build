# Benki Multi-Agent System — Root Environment Variables
# Copy to .env and fill in local secrets. Never commit .env.

# PostgreSQL
POSTGRES_PASSWORD=change_me_generate_a_long_random_value
DATABASE_URL=postgresql://benki:change_me_generate_a_long_random_value@postgres:5432/benki

# Hermes API Server shared secret for UI → agent communication
API_SERVER_KEY=change_me_generate_32_plus_random_chars

# Dashboard API/browser protection. Required for VPS deployments.
DASHBOARD_TOKEN=change_me_generate_32_plus_random_chars

# LLM Providers
OPENROUTER_API_KEY=
MINIMAX_API_KEY=

# Feature toggles
FEATURE_TRADING=false
FEATURE_PREDICTIONS=false
