# Benki Predictor (Kalshi Prediction Markets) — Environment Variables
# Copy to configs/predictor/.env and fill in local secrets. Never commit configs/predictor/.env.

# Discord Bot Token for benki_predictor
DISCORD_TOKEN=

# LLM Provider
OPENROUTER_API_KEY=

# Database
BENKI_DB_URL=postgresql://benki:change_me_generate_a_long_random_value@postgres:5432/benki

# Kalshi API Credentials
# Create these at https://kalshi.com/account/profile under API Keys.
KALSHI_API_KEY_ID=

# Recommended: save the RSA private key text from Kalshi into a local ignored file.
# The file can be named .pem even if Kalshi gave you the key as text.
# Example Windows container path if mounted later: /run/secrets/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=

# Alternative only if you can safely inject multiline env vars from your secret manager.
# Prefer KALSHI_PRIVATE_KEY_PATH for local Docker usage.
KALSHI_PRIVATE_KEY=

# Production endpoint. Use demo endpoint only for Kalshi demo accounts.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Safe default
DRY_RUN=true
