# Benki Main (Orchestrator) — Environment Variables
# Copy to configs/main/.env and fill in local secrets. Never commit configs/main/.env.

# Discord Bot Token for benki_main
DISCORD_TOKEN=

# LLM Provider
OPENROUTER_API_KEY=

# Database
BENKI_DB_URL=postgresql://benki:change_me_generate_a_long_random_value@postgres:5432/benki

# Safe default
DRY_RUN=true
