# Benki Trader (Robinhood MCP Execution) — Environment Variables
# Copy to configs/trader/.env and fill in local secrets/details. Never commit configs/trader/.env.

# Discord Bot Token for benki_trader
DISCORD_TOKEN=

# LLM Provider
OPENROUTER_API_KEY=

# Database
BENKI_DB_URL=postgresql://benki:change_me_generate_a_long_random_value@postgres:5432/benki

# Robinhood MCP Configuration
# This should match the MCP server name configured in your local MCP client/server setup.
ROBINHOOD_MCP_SERVER=robinhood
ROBINHOOD_ACCOUNT_ID=

# Safe default
DRY_RUN=true
